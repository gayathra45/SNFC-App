{
  "expo": {
    "name": "S NFC Writer",
    "slug": "s-nfc-writer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "s-nfc-writer",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#102A43"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sanasa.snfcwriter"
    },
    "android": {
      "package": "com.sanasa.snfcwriter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102A43"
      },
      "permissions": [
        "android.permission.NFC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "react-native-nfc-manager",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#102A43",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f79d8fbc-ff2f-4e87-832f-b54004d4ce8c"
      }
    }
  }
}
