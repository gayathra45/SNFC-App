{
  "expo": {
    "name": "SANASA NFC Writer",
    "slug": "sanasa-nfc-writer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sanasa-nfc-writer",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#102A43"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sanasa.nfcwriter"
    },
    "android": {
      "package": "com.sanasa.nfcwriter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102A43"
      },
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "plugins": [
      "expo-router",
      "react-native-nfc-manager"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
